OPENAI_API_KEY=sk-...
RELAY_BASE_URL=http://127.0.0.1:8787
PORT=3000
SERVER_URL=http://127.0.0.1:3000
# Public URL phones use (e.g. from `npm run tunnel`); the QR code points here
PUBLIC_URL=
# Set to 0 to disable the auto-director (self-running events and votes)
AUTO_DIRECTOR=1
# Optional: use Terse Cloud instead of the local actor runtime (terse deploy prints the URL; create a key at app.useterse.ai)
TERSE_ACTOR_URL=
TERSE_API_KEY=
UNIVERSE_ID=universe-live
# Optional: Supabase archive (project URL + secret key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
